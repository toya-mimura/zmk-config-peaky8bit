// DIAGNOSTIC keymap: test which key-positions actually fire combos.
// Each combo outputs a unique identifier so you can see exactly which positions matched.
//
// Combo naming: pos X + pos Y → outputs "XY" (e.g. pos 2 + pos 7 → outputs "c7" ... no,
// let's use macros that output the position numbers clearly)

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    macros {
        // Diagnostic macros: output the combo positions as text
        // Format: left_pos + right_pos → types "[L{left}R{right}]"

        // pos 0 (左SW1) + 右手各キー
        diag_0_4: diag_0_4 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp N0>, <&kp N4>, <&kp RBKT>; };
        diag_0_5: diag_0_5 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp N0>, <&kp N5>, <&kp RBKT>; };
        diag_0_6: diag_0_6 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp N0>, <&kp N6>, <&kp RBKT>; };
        diag_0_7: diag_0_7 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp N0>, <&kp N7>, <&kp RBKT>; };

        // pos 1 (左SW2) + 右手各キー
        diag_1_4: diag_1_4 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp N1>, <&kp N4>, <&kp RBKT>; };
        diag_1_5: diag_1_5 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp N1>, <&kp N5>, <&kp RBKT>; };
        diag_1_6: diag_1_6 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp N1>, <&kp N6>, <&kp RBKT>; };
        diag_1_7: diag_1_7 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp N1>, <&kp N7>, <&kp RBKT>; };

        // pos 2 (左SW3) + 右手各キー
        diag_2_4: diag_2_4 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp N2>, <&kp N4>, <&kp RBKT>; };
        diag_2_5: diag_2_5 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp N2>, <&kp N5>, <&kp RBKT>; };
        diag_2_6: diag_2_6 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp N2>, <&kp N6>, <&kp RBKT>; };
        diag_2_7: diag_2_7 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp N2>, <&kp N7>, <&kp RBKT>; };

        // pos 3 (左SW4) + 右手各キー
        diag_3_4: diag_3_4 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp N3>, <&kp N4>, <&kp RBKT>; };
        diag_3_5: diag_3_5 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp N3>, <&kp N5>, <&kp RBKT>; };
        diag_3_6: diag_3_6 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp N3>, <&kp N6>, <&kp RBKT>; };
        diag_3_7: diag_3_7 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp N3>, <&kp N7>, <&kp RBKT>; };

        // 左手同士のcombo（BLEを経由しない）
        diag_0_1: diag_0_1 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp N0>, <&kp N1>, <&kp RBKT>; };
        diag_0_2: diag_0_2 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp N0>, <&kp N2>, <&kp RBKT>; };
        diag_0_3: diag_0_3 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp N0>, <&kp N3>, <&kp RBKT>; };
        diag_1_2: diag_1_2 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp N1>, <&kp N2>, <&kp RBKT>; };
        diag_1_3: diag_1_3 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp N1>, <&kp N3>, <&kp RBKT>; };
        diag_2_3: diag_2_3 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp N2>, <&kp N3>, <&kp RBKT>; };

        // 右手同士のcombo
        diag_4_5: diag_4_5 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp N4>, <&kp N5>, <&kp RBKT>; };
        diag_4_6: diag_4_6 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp N4>, <&kp N6>, <&kp RBKT>; };
        diag_4_7: diag_4_7 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp N4>, <&kp N7>, <&kp RBKT>; };
        diag_5_6: diag_5_6 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp N5>, <&kp N6>, <&kp RBKT>; };
        diag_5_7: diag_5_7 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp N5>, <&kp N7>, <&kp RBKT>; };
        diag_6_7: diag_6_7 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp N6>, <&kp N7>, <&kp RBKT>; };
    };

    combos {
        compatible = "zmk,combos";

        // === 左手 + 右手 (全16組) ===
        c_0_4 { timeout-ms = <200>; key-positions = <0 4>; layers = <0>; bindings = <&diag_0_4>; };
        c_0_5 { timeout-ms = <200>; key-positions = <0 5>; layers = <0>; bindings = <&diag_0_5>; };
        c_0_6 { timeout-ms = <200>; key-positions = <0 6>; layers = <0>; bindings = <&diag_0_6>; };
        c_0_7 { timeout-ms = <200>; key-positions = <0 7>; layers = <0>; bindings = <&diag_0_7>; };
        c_1_4 { timeout-ms = <200>; key-positions = <1 4>; layers = <0>; bindings = <&diag_1_4>; };
        c_1_5 { timeout-ms = <200>; key-positions = <1 5>; layers = <0>; bindings = <&diag_1_5>; };
        c_1_6 { timeout-ms = <200>; key-positions = <1 6>; layers = <0>; bindings = <&diag_1_6>; };
        c_1_7 { timeout-ms = <200>; key-positions = <1 7>; layers = <0>; bindings = <&diag_1_7>; };
        c_2_4 { timeout-ms = <200>; key-positions = <2 4>; layers = <0>; bindings = <&diag_2_4>; };
        c_2_5 { timeout-ms = <200>; key-positions = <2 5>; layers = <0>; bindings = <&diag_2_5>; };
        c_2_6 { timeout-ms = <200>; key-positions = <2 6>; layers = <0>; bindings = <&diag_2_6>; };
        c_2_7 { timeout-ms = <200>; key-positions = <2 7>; layers = <0>; bindings = <&diag_2_7>; };
        c_3_4 { timeout-ms = <200>; key-positions = <3 4>; layers = <0>; bindings = <&diag_3_4>; };
        c_3_5 { timeout-ms = <200>; key-positions = <3 5>; layers = <0>; bindings = <&diag_3_5>; };
        c_3_6 { timeout-ms = <200>; key-positions = <3 6>; layers = <0>; bindings = <&diag_3_6>; };
        c_3_7 { timeout-ms = <200>; key-positions = <3 7>; layers = <0>; bindings = <&diag_3_7>; };

        // === 左手同士 (6組、BLE不要) ===
        c_0_1 { timeout-ms = <200>; key-positions = <0 1>; layers = <0>; bindings = <&diag_0_1>; };
        c_0_2 { timeout-ms = <200>; key-positions = <0 2>; layers = <0>; bindings = <&diag_0_2>; };
        c_0_3 { timeout-ms = <200>; key-positions = <0 3>; layers = <0>; bindings = <&diag_0_3>; };
        c_1_2 { timeout-ms = <200>; key-positions = <1 2>; layers = <0>; bindings = <&diag_1_2>; };
        c_1_3 { timeout-ms = <200>; key-positions = <1 3>; layers = <0>; bindings = <&diag_1_3>; };
        c_2_3 { timeout-ms = <200>; key-positions = <2 3>; layers = <0>; bindings = <&diag_2_3>; };

        // === 右手同士 (6組、BLE不要) ===
        c_4_5 { timeout-ms = <200>; key-positions = <4 5>; layers = <0>; bindings = <&diag_4_5>; };
        c_4_6 { timeout-ms = <200>; key-positions = <4 6>; layers = <0>; bindings = <&diag_4_6>; };
        c_4_7 { timeout-ms = <200>; key-positions = <4 7>; layers = <0>; bindings = <&diag_4_7>; };
        c_5_6 { timeout-ms = <200>; key-positions = <5 6>; layers = <0>; bindings = <&diag_5_6>; };
        c_5_7 { timeout-ms = <200>; key-positions = <5 7>; layers = <0>; bindings = <&diag_5_7>; };
        c_6_7 { timeout-ms = <200>; key-positions = <6 7>; layers = <0>; bindings = <&diag_6_7>; };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // 単キー出力: pos番号がわかるようにアルファベット+数字
            // pos0=A pos1=B pos2=C pos3=D pos4=1 pos5=2 pos6=3 pos7=4
            bindings = <
                &kp A   &kp B   &kp C   &kp D
                &kp N1  &kp N2  &kp N3  &kp N4
            >;
        };
    };
};
