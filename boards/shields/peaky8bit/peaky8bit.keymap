    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
                &kp A   &kp B   &kp C   &kp D
                &kp N1  &kp N2  &kp N3  &kp N4
            >;
        };
        shift_armed_layer {
            bindings = <
                &none  &none  &none  &none
                &none  &none  &none  &none
            >;
        };
        ctrl_armed_layer {
            bindings = <
                &none  &none  &none  &none
                &none  &none  &none  &none
            >;
        };
        alt_armed_layer {
            bindings = <
                &none  &none  &none  &none
                &none  &none  &none  &none
            >;
        };
        shift_ctrl_armed_layer {
            bindings = <
