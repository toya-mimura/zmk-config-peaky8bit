// Peaky 8-bit shield common definitions
// Direct GPIO scan (4 keys per side)

#include <dt-bindings/zmk/matrix_transform.h>
#include "peaky8bit-layouts.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan;
        zmk,physical-layout = &default_layout;
    };

    kscan: kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        // input-gpios are defined per-side in _left.overlay and _right.overlay
    };

    default_transform: default_transform {
        compatible = "zmk,matrix-transform";
        columns = <4>;
        rows = <2>;
        map = 
            RC(0, 0) RC(0, 1) RC(0, 2) RC(0, 3)
            RC(1, 0) RC(1, 1) RC(1, 2) RC(1, 3)
        >;
    };
};